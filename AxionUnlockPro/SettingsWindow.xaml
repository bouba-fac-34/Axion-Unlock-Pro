<Window x:Class="AxionUnlockPro.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="420" Width="520" WindowStartupLocation="CenterOwner"
        Background="#12121A" WindowStyle="ToolWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Tool paths" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="ADB" Foreground="#8A8A9A" FontSize="11"/>
            <TextBox x:Name="txtAdb" Margin="0,2,0,8" Background="#1A1A24" Foreground="#E0E0E8" BorderBrush="#2A2A38"/>
            <TextBlock Text="Fastboot" Foreground="#8A8A9A" FontSize="11"/>
            <TextBox x:Name="txtFb" Margin="0,2,0,8" Background="#1A1A24" Foreground="#E0E0E8" BorderBrush="#2A2A38"/>
            <TextBlock Text="edl (bkerler)" Foreground="#8A8A9A" FontSize="11"/>
            <TextBox x:Name="txtEdl" Margin="0,2,0,8" Background="#1A1A24" Foreground="#E0E0E8" BorderBrush="#2A2A38"/>
            <TextBlock Text="mtk (mtkclient)" Foreground="#8A8A9A" FontSize="11"/>
            <TextBox x:Name="txtMtk" Margin="0,2,0,8" Background="#1A1A24" Foreground="#E0E0E8" BorderBrush="#2A2A38"/>
            <TextBlock Text="Programmers root" Foreground="#8A8A9A" FontSize="11"/>
            <TextBox x:Name="txtProg" Margin="0,2,0,8" Background="#1A1A24" Foreground="#E0E0E8" BorderBrush="#2A2A38"/>
            <CheckBox x:Name="chkAuto" Content="Auto-select brand on connect" Foreground="#C8C8D8" Margin="0,8,0,4"/>
            <CheckBox x:Name="chkLog" Content="Persist session log to logs/" Foreground="#C8C8D8"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click" Background="#2A2A38" Foreground="#E0E0E8"/>
            <Button Content="Save" Width="90" Click="Save_Click" Background="#7C4DFF" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
