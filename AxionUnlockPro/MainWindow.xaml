<Window x:Class="AxionUnlockPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Axion Unlock Pro v2" Height="900" Width="1360"
        WindowStartupLocation="CenterScreen" Background="#0B0B0F"
        WindowStyle="None" AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border CornerRadius="14" Background="#0B0B0F" BorderBrush="#2A2A38" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="210"/>
            </Grid.RowDefinitions>
            <Border Grid.ColumnSpan="3" Background="#12121A" CornerRadius="14,14,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <TextBlock Text="AXION" Foreground="#00E5FF" FontWeight="Bold" FontSize="17"/>
                        <TextBlock Text=" UNLOCK PRO" Foreground="#E8E8F0" FontWeight="SemiBold" FontSize="17"/>
                        <Border Background="#7C4DFF" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v2.1" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Button Content="⚙" Width="40" Height="30" Style="{StaticResource TitleBtn}" Click="Settings_Click" ToolTip="Settings"/>
                        <Button Content="─" Width="40" Height="30" Style="{StaticResource TitleBtn}" Click="Minimize_Click"/>
                        <Button Content="□" Width="40" Height="30" Style="{StaticResource TitleBtn}" Click="Maximize_Click"/>
                        <Button Content="✕" Width="40" Height="30" Style="{StaticResource TitleBtn}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="#12121A" Margin="10,10,4,10" CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10" x:Name="brandPanel">
                        <TextBlock Text="BRANDS" Foreground="#5A5A6A" FontSize="11" FontWeight="Bold" Margin="6,6,0,10"/>
                        <Button Content="Samsung" Style="{StaticResource BrandBtn}" Tag="Samsung" Click="Brand_Click"/>
                        <Button Content="Tecno / Infinix / Itel" Style="{StaticResource BrandBtn}" Tag="Transsion" Click="Brand_Click"/>
                        <Button Content="Xiaomi / Redmi / Poco" Style="{StaticResource BrandBtn}" Tag="Xiaomi" Click="Brand_Click"/>
                        <Button Content="Oppo / Realme" Style="{StaticResource BrandBtn}" Tag="Oppo" Click="Brand_Click"/>
                        <Button Content="Huawei / Honor" Style="{StaticResource BrandBtn}" Tag="Huawei" Click="Brand_Click"/>
                        <Button Content="Motorola" Style="{StaticResource BrandBtn}" Tag="Motorola" Click="Brand_Click"/>
                        <Button Content="Vivo" Style="{StaticResource BrandBtn}" Tag="Vivo" Click="Brand_Click"/>
                        <Button Content="MediaTek (DA/BROM)" Style="{StaticResource BrandBtn}" Tag="MTK" Click="Brand_Click"/>
                        <Button Content="Qualcomm EDL" Style="{StaticResource BrandBtn}" Tag="Qualcomm" Click="Brand_Click"/>
                        <Button Content="SPD / Unisoc" Style="{StaticResource BrandBtn}" Tag="SPD" Click="Brand_Click"/>
                        <Button Content="Universal ADB" Style="{StaticResource BrandBtn}" Tag="Universal" Click="Brand_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Row="1" Grid.Column="1" Margin="4,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#1A1A24" CornerRadius="12" Padding="18" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="txtDeviceStatus" Text="No device connected" Foreground="#C8C8D8" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtDeviceDetails" Text="Connect phone · USB debugging ON · authorize PC" Foreground="#6A6A7A" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Ellipse x:Name="statusDot" Width="14" Height="14" Fill="#FF5252" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="opsPanel"/>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="1" Grid.Column="2" Background="#12121A" Margin="4,10,10,10" CornerRadius="12">
                <StackPanel Margin="14">
                    <TextBlock Text="SESSION" Foreground="#5A5A6A" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="txtSession" Text="Select a brand to begin" Foreground="#B0B0C0" TextWrapping="Wrap" FontSize="13"/>
                    <Border Height="1" Background="#2A2A38" Margin="0,14"/>
                    <TextBlock Text="QUICK GUIDE" Foreground="#5A5A6A" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Foreground="#7A7A8C" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                               Text="• ADB: USB debugging + authorize&#10;• Download: Vol− + Power (Samsung)&#10;• EDL: adb reboot edl / test point&#10;• Preloader: power off + Vol&#10;• After unlock: Disable OTA to stop relock"/>
                    <Border Height="1" Background="#2A2A38" Margin="0,14"/>
                    <TextBlock Text="FEATURES v2.1" Foreground="#5A5A6A" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Foreground="#8A8A9A" FontSize="11" TextWrapping="Wrap"
                               Text="FRP · MDM · KG · Screen lock · Demo · Mi Account · Anti-relock · Disable OTA · Factory reset · Device info · EDL/DA · Odin path · Auto-brand · Settings"/>
                </StackPanel>
            </Border>
            <ProgressBar x:Name="progressBar" Grid.Row="2" Grid.ColumnSpan="3" Height="6" Margin="10,0,10,4"
                         Background="#1A1A24" Foreground="#00E5FF" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
            <Border Grid.Row="3" Grid.ColumnSpan="3" Background="#0E0E14" Margin="10,0,10,10" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="14,8,14,4">
                        <TextBlock Text="LIVE LOG" Foreground="#5A5A6A" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="Clear" Style="{StaticResource TitleBtn}" Padding="10,2" Click="ClearLog_Click" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBox x:Name="txtLog" Grid.Row="1" Background="Transparent" Foreground="#00E5FF"
                             FontFamily="Consolas" FontSize="12" IsReadOnly="True" BorderThickness="0"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="12,0,12,10" AcceptsReturn="True"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
