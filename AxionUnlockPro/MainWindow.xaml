<Window x:Class="AxionUnlockPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Axion Unlock Pro" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F13"
        WindowStyle="None" AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border CornerRadius="12" Background="#0F0F13" BorderBrush="#2A2A35" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.ColumnSpan="3" Background="#16161D" CornerRadius="12,12,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="AXION" Foreground="#00F0FF" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text=" UNLOCK PRO" Foreground="#E0E0E8" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="  v1.0" Foreground="#555" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <Button Content="─" Width="42" Height="32" Style="{StaticResource TitleBtn}" Click="Minimize_Click"/>
                        <Button Content="□" Width="42" Height="32" Style="{StaticResource TitleBtn}" Click="Maximize_Click"/>
                        <Button Content="✕" Width="42" Height="32" Style="{StaticResource TitleBtn}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Left Sidebar -->
            <Border Grid.Row="1" Background="#16161D" Margin="8,8,4,8" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="BRANDS" Foreground="#666" FontSize="11" Margin="8,8,0,10" FontWeight="SemiBold"/>
                        <Button Content="Samsung" Style="{StaticResource BrandBtn}" Tag="Samsung" Click="Brand_Click"/>
                        <Button Content="Tecno / Infinix / Itel" Style="{StaticResource BrandBtn}" Tag="Transsion" Click="Brand_Click"/>
                        <Button Content="Xiaomi / Redmi / Poco" Style="{StaticResource BrandBtn}" Tag="Xiaomi" Click="Brand_Click"/>
                        <Button Content="Oppo / Realme" Style="{StaticResource BrandBtn}" Tag="Oppo" Click="Brand_Click"/>
                        <Button Content="Huawei / Honor" Style="{StaticResource BrandBtn}" Tag="Huawei" Click="Brand_Click"/>
                        <Button Content="Motorola" Style="{StaticResource BrandBtn}" Tag="Motorola" Click="Brand_Click"/>
                        <Button Content="MediaTek Generic" Style="{StaticResource BrandBtn}" Tag="MTK" Click="Brand_Click"/>
                        <Button Content="Qualcomm EDL" Style="{StaticResource BrandBtn}" Tag="Qualcomm" Click="Brand_Click"/>
                        <Button Content="Others" Style="{StaticResource BrandBtn}" Tag="Others" Click="Brand_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status Card -->
                <Border Background="#1C1C26" CornerRadius="10" Padding="18" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="txtDeviceStatus" Text="No device connected" Foreground="#AAA" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtDeviceDetails" Text="Connect a phone via USB" Foreground="#666" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Ellipse x:Name="statusDot" Width="14" Height="14" Fill="#FF4444" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Operations -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="opsPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Grid>

            <!-- Right Panel -->
            <Border Grid.Row="1" Grid.Column="2" Background="#16161D" Margin="4,8,8,8" CornerRadius="10">
                <StackPanel Margin="14">
                    <TextBlock Text="SESSION" Foreground="#666" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="txtSession" Text="Idle – select brand" Foreground="#CCC" TextWrapping="Wrap" FontSize="13"/>
                    <Border Height="1" Background="#2A2A35" Margin="0,16"/>
                    <TextBlock Text="QUICK INFO" Foreground="#666" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="• Put device in correct mode&#10;• ADB: USB debugging ON&#10;• Download: Vol- + Power&#10;• EDL: test point or adb reboot edl&#10;• Preloader: power off + volume" 
                               Foreground="#888" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>
            </Border>

            <!-- Log -->
            <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#121218" Margin="8,0,8,8" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="12,8,12,4">
                        <TextBlock Text="LOG" Foreground="#666" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Clear" HorizontalAlignment="Right" Style="{StaticResource TitleBtn}" 
                                Padding="8,2" Click="ClearLog_Click" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <TextBox x:Name="txtLog" Grid.Row="1" Background="Transparent" Foreground="#00F0FF"
                             FontFamily="Consolas" FontSize="12" IsReadOnly="True" BorderThickness="0"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="10,0,10,10"
                             AcceptsReturn="True"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
